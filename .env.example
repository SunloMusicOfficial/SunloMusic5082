# ══════════════════════════════════════════════════════════════
#  🎵 S U N L O   M U S I C  -  E N V I R O N M E N T   G U I D E
# ══════════════════════════════════════════════════════════════
#  ⚠️  IMPORTANT: 
#  - Rename this file to '.env' before running the bot.
#  - Command: cp .env.example .env
#  - NEVER share your .env file or commit it to GitHub.
# ══════════════════════════════════════════════════════════════

# ── 🔑 TELEGRAM API CREDENTIALS ───────────────────────────────
# Get these from: https://my.telegram.org (Login > API Development Tools)
API_ID=1234567
API_HASH=your_api_hash_here

# Get this from: @BotFather on Telegram (Create a new bot)
BOT_TOKEN=your_bot_token_here

# ── 🤖 ASSISTANT USERBOT (VOICE CHAT JOIN) ────────────────────
# This account will join Voice Chats. Do NOT use your main account.
# Generate this by running: python scripts/generate_session.py
SESSION_STRING=your_pyrogram_string_session_here

# ── 🗄️ DATABASE (MongoDB) ─────────────────────────────────────
# Get a free cluster from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=SunloMusic

# ── 👑 OWNER & ADMIN SETTINGS ─────────────────────────────────
# Your Telegram User ID (Get it from @userinfobot)
OWNER_ID=123456789
# Add multiple sudo users by separating IDs with a space
SUDO_USERS=123456789 987654321

# ── 📢 BRANDING & SUPPORT ─────────────────────────────────────
BOT_NAME=Sunlo Music
BOT_USERNAME=@SunloMusicBot
SUPPORT_CHANNEL=https://t.me/Vip_Sakil_Bio
SUPPORT_CHAT=https://t.me/YO_UR_OFFICIAL_CRUSH

# ── 📝 LOGGING & ERROR TRACKING ───────────────────────────────
# Create a private group, add the bot as admin, and put the group ID here (-100...)
LOG_CHANNEL=0
LOG_GROUP_ID=0

# ── 🔐 SUNLOMUSIC API KEY (IMPORTANT) ─────────────────────────
# Contact the Owner to get your SunloMusicApi Key.
SUNLO_API_KEY=your_sunlo_music_api_key_here

# Optional: Get free API key from https://dashboard.audd.io/ for /shazam
AUDD_API_KEY=your_audd_api_key_here

# ── 🖼️ IMAGE SETTINGS ─────────────────────────────────────────
# Direct URL for the /start command image (Use /geturl to generate this)
START_IMG_URL=https://telegra.ph/file/your_image_link.jpg

# ── ⚡ PERFORMANCE SETTINGS (Do not change unless you know) ───
CACHE_DIR=cache
MAX_CACHE_SIZE_MB=2048
PRELOAD_NEXT=True
DOWNLOAD_WORKERS=4
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=50
LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════
